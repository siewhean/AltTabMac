{
  "name": "cmdtab-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run security:deps && npm run seo:check && npm run typecheck",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seo:check": "node scripts/verify-seo.mjs && node scripts/verify-showcase-media.mjs && node scripts/verify-showcase-copy.mjs",
    "rendered:check": "python3 scripts/verify-rendered-site.py",
    "browser:check": "node scripts/verify-browser.mjs",
    "webmaster:check": "node scripts/verify-webmaster-metadata.mjs",
    "evidence:check": "node scripts/verify-public-evidence.mjs",
    "retrieval:check": "node scripts/verify-retrieval-surfaces.mjs",
    "showcase:check": "node scripts/verify-showcase-media.mjs",
    "showcase:responses": "node scripts/verify-showcase-responses.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "security:check": "npm run security:deps && npm run seo:check && npm run typecheck && next build --webpack"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.2.10",
    "postgres": "^3.4.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
