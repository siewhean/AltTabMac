NEXT_PUBLIC_SITE_URL=https://cmdtab.net
SITE_URL=https://cmdtab.net
INDEXNOW_KEY=replace-with-8-to-128-character-key
GOOGLE_SITE_VERIFICATION=replace-with-search-console-meta-token
BING_SITE_VERIFICATION=replace-with-bing-msvalidate-token

RESEND_API_KEY=your_resend_api_key
WAITLIST_FROM_EMAIL=hello@cmdtab.net
WAITLIST_TO_EMAIL=support@cmdtab.net
WAITLIST_REPLY_TO_EMAIL=support@cmdtab.net
DATABASE_URL=postgres://user:password@host:5432/database

# Production dashboard authentication (Auth0 Universal Login + required MFA)
AUTH0_ISSUER_BASE_URL=https://your-tenant.example.auth0.com
AUTH0_CLIENT_ID=replace_with_your_auth0_client_id
AUTH0_CLIENT_SECRET=replace_with_your_auth0_client_secret
AUTH0_OWNER_SUBJECT=auth0|replace_with_the_exact_owner_subject
AUTH0_BASE_URL=https://cmdtab.net
ADMIN_DASHBOARD_SECRET=replace_with_at_least_32_random_bytes
ADMIN_DASHBOARD_SESSION_GENERATION=1

# Explicit development/test fallback only. Production ignores this mode.
ADMIN_ENABLE_LEGACY_PASSWORD=false
ADMIN_DASHBOARD_PASSWORD=replace_with_a_local_development_password

# Keep this disabled while commerce is not launched. Checkout and fulfilment
# remain fail-closed. Set to 1 only after every production commerce value below
# has been configured and validated.
CMDTAB_REQUIRE_COMMERCE_READY=0
NEXT_PUBLIC_CHECKOUT_PROVIDER=lemonsqueezy
NEXT_PUBLIC_CHECKOUT_URL=https://buy.example.com/cmdtab
NEXT_PUBLIC_LICENSE_PORTAL_URL=https://buy.example.com/cmdtab-license
NEXT_PUBLIC_SUPPORT_EMAIL=support@cmdtab.net
LEMONSQUEEZY_WEBHOOK_SECRET=replace_with_your_lemonsqueezy_webhook_secret
CMDTAB_LEMONSQUEEZY_STORE_ID=12345
CMDTAB_LEMONSQUEEZY_PRODUCT_ID=12345
CMDTAB_LEMONSQUEEZY_VARIANT_ID=12345
# Use false in production and true only on the isolated sandbox deployment.
CMDTAB_LEMONSQUEEZY_EXPECT_TEST_MODE=false
# Local migration/testing only. Production token-v2 signing rejects PEM.
CMDTAB_LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nreplace_with_your_signing_key\n-----END PRIVATE KEY-----"
CMDTAB_TRIAL_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nlocal_testing_only\n-----END PRIVATE KEY-----"
# Public verification-only key retained while grandfathered CMDTAB1 licenses
# remain accepted. This contains no private material.
CMDTAB_LICENSE_V1_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nreplace_with_v1_public_key\n-----END PUBLIC KEY-----"
AWS_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/cmdtab-vercel-production-signing
CMDTAB_TRIAL_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/replace-with-trial-key-id
CMDTAB_TRIAL_SIGNING_KID=trial-2026-01
CMDTAB_LICENSE_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/replace-with-license-key-id
CMDTAB_LICENSE_SIGNING_KID=license-2026-01
CMDTAB_TRIAL_PUBLIC_KEYRING_JSON={"trial-2026-01":"base64-spki-der"}
CMDTAB_LICENSE_PUBLIC_KEYRING_JSON={"license-2026-01":"base64-spki-der"}
CMDTAB_LICENSE_LOOKUP_PEPPER=replace_with_at_least_32_random_bytes
CMDTAB_LICENSE_OUTBOX_SECRET=replace_with_a_random_internal_worker_secret
LICENSE_DELIVERY_FROM_EMAIL=hello@cmdtab.net
CRON_SECRET=replace_with_a_random_cron_secret
